# Application
APP_NAME="AI Task Assistant"
ENVIRONMENT="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"
SECRET_KEY="replace-this-with-a-secure-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (SQLite default for local dev, or PostgreSQL)
DATABASE_URL="sqlite+aiosqlite:///./data/assistant.db"
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/ai_task_assistant"

# AI Provider (OpenAI, Gemini, or Ollama)
AI_PROVIDER="openai" # options: openai, gemini, ollama
AI_API_KEY="your-api-key-here"
AI_MODEL_NAME="gpt-4o-mini"

# Google Integration (OAuth & Calendar/Gmail)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/google/callback"
GOOGLE_PUBSUB_TOPIC="projects/your-project/topics/gmail-notifications"

# Zalo Integration (Official Account)
ZALO_APP_ID="your-zalo-app-id"
ZALO_APP_SECRET="your-zalo-app-secret"
ZALO_OA_SECRET_KEY="your-oa-secret-key"
ZALO_WEBHOOK_SECRET="your-webhook-secret"

# Worker & Scheduler
POLL_INTERVAL_SECONDS=60
